---

<style>
  .content {
    animation: 0.25s linear 0.25s fadeIn;
    animation-fill-mode: forwards;
    opacity: 0;
  }

  @keyframes fadeIn {
    from {
      transform: translateY(1rem);
      opacity: 0;
    }

    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>
<Layout
  title="Projects"
  description="Collection of various projects that I've done for school, for hackathons, or for fun."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-8 overflow-hidden pt-5">
    <h1 class="font-mono text-2xl sm:text-3xl md:text-5xl text-center">
      Projects
    </h1>
    <p class="text-lg mt-5 text-center">
      These include everything from hackathon projects to school assignments to
      mini-projects built for fun!
    </p>
    <div
      class="grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-3 mt-5 content relative"
    >
      {
        projects.map((project) => (
          <a
            class="relative border border-gray-300 transition duration-30 overflow-hidden group"
            href={project.href}
            target="_blank"
          >
            <Image
              alt={project.imageAlt}
              class="absolute w-full h-60 group-hover:scale-110 transition object-center object-cover"
              sizes="(max-width: 543px) 509px, (max-width: 837px) 379px, (max-width: 1099px) 335px, 293px"
              widths={[293, 335, 379, 509]}
              src={project.imageSrc}
            />
            <div
              class:list={[
                "mt-52 py-2 px-5 pb-5 pt-6 h-full relative",
                project.textColor,
              ]}
              style={`background-image: linear-gradient(to bottom, rgba(${project.bgColor}, 0) 0%, rgba(${project.bgColor}, 1) 1rem);`}
            >
              <h2 class="text-xl font-bold">{project.name}</h2>
              <p>{project.description}</p>
              <div class="flex flex-wrap gap-2 mt-2">
                {project.tags.map((tag) => (
                  <span
                    class:list={[
                      "px-3 py-1 rounded-full text-sm",
                      project.tagColor,
                    ]}
                  >
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </main>
</Layout>

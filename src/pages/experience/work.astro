---
import Timeline from "../../components/Timeline.astro";
import Layout from "../../layouts/Layout.astro";

const experiences = [
  {
    title: "Engineering Intern",
    company: "Shopify",
    period: "May 2025 - Aug. 2025",
    type: "Full-time internship",
    points: ["Incoming Summer 2025"],
    skills: [],
  },
  {
    title: "Innovation Developer",
    company: "Royal Bank of Canada",
    period: "July 2024 - Aug. 2024",
    type: "Full-time internship",
    points: [
      "Worked with an Agile team to build and deploy a mortgage calculator using Angular, Spring Boot, and Docker to help 180,000+ clients renew their mortgages",
      "Demonstrated and pitched the project to 100+ stakeholders",
    ],
    skills: ["Angular", "TypeScript", "Spring Boot", "Java", "Docker"],
  },
  {
    title: "Tootor Chief Website Manager",
    company: "NewArts Toronto",
    period: "May 2023 - Sept. 2023",
    type: "Part-time job",
    points: [
      "Managed a tutoring service with 60+ tutors and 500+ tutoring sessions per month",
      "Implemented streaming, voice support, interactive activities, and function calling into a GPT-3.5 AI tutor",
      "Led weekly team meetings to discuss changes and potential new features for the website",
      "Adjusted colour contrast and metadata to comply with Web Content Accessibility Guidelines (WCAG)",
      "Wrote and published daily social media posts on Instagram, X, and Threads in the 3 weeks leading up to the 2023-24 school year",
    ],
    skills: ["JavaScript", "OpenAI API"],
  },
  {
    title: "Quality Assurance Analyst",
    company: "GoalLine Solutions",
    period: "June 2023 - Aug. 2023",
    type: "Part-time internship",
    points: [
      "Tested functionality, user interface, and calculations to ensure they followed specifications",
      "Created 200+ bug tickets on Azure DevOps with screenshots and steps to reproduce",
    ],
    skills: ["Testing"],
  },
  {
    title: "Software Engineer Intern",
    company: "North P&D",
    period: "Feb. 2023 - June 2023",
    timelineDate: "February 2023",
    type: "Part-time internship",
    points: [
      "Helped implement a website for a client using Webflow",
      "Added new clients to the company website",
      "Submitted 10+ pull requests implementing various features on the company's website, including English-French translation using react-i18next and improved loading speed",
    ],
    skills: ["JavaScript", "React", "Webflow"],
  },
];
---

<Layout
  title="Work Experience"
  description="Information about my experience from my various jobs."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-8 pt-5 flex items-center flex-col">
    <h1 class="font-mono text-2xl sm:text-3xl md:text-5xl text-center">
      Work Experience
    </h1>
    <Timeline experiences={experiences} />
  </main>
</Layout>
